# Copy to .env.preview; keep out of Git. Generate secrets with openssl rand -hex 32.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://xueba:CHANGE_ME@127.0.0.1:5432/xueba_preview
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8320
TRUSTED_ORIGINS=http://localhost:8320,http://localhost:8321,http://localhost:8322,http://localhost:8323
COOKIE_DOMAIN=
# Tool links are inlined at build time. Public IP settings: ops/public-ip.env.example.
NEXT_PUBLIC_HANZI_URL=http://localhost:8321/
NEXT_PUBLIC_GUWEN_URL=http://localhost:8322/
NEXT_PUBLIC_TASKHELPER_URL=http://localhost:8323/
# Safe default true; set false explicitly in the isolated early-stage preview.
REQUIRE_EMAIL_VERIFICATION=true
# Random 32+ character secret shared ONLY with the private loopback Nginx config.
TRUSTED_PROXY_SECRET=
# disabled fails clearly; development is a private file outbox, not real email delivery.
MAIL_PROVIDER=disabled
ENABLE_DEV_MAIL=false
DEV_MAIL_DIR=./mail-outbox
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Tencent Cloud SES API: verified sender address only in MAIL_FROM (no display name).
# Templates contain a fixed BETTER_AUTH_URL origin followed by {{path}}.
# Keep disabled until sender DNS, approved templates and a real delivery test pass.
# MAIL_PROVIDER=tencent-ses
SES_REGION=ap-guangzhou
SES_SECRET_ID=
SES_SECRET_KEY=
SES_SESSION_TOKEN=
SES_VERIFY_TEMPLATE_ID=
SES_RESET_TEMPLATE_ID=
COS_BUCKET=
COS_REGION=
TENCENT_SERVER_REGION=
COS_CAM_ROLE=
COS_SECRET_ID=
COS_SECRET_KEY=
COS_SESSION_TOKEN=
COS_TOKEN_EXPIRY=
COS_INTERNAL=false
COS_BACKUP_PREFIX=unified-preview/backups/
