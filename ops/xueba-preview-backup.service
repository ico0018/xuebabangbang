[Unit]
Description=Back up isolated Xueba preview database
[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/srv/xuebabangbang-unified-preview/portal
Environment=DOCKER_HOST=unix:///run/user/1000/docker.sock
Environment=BACKUP_TARGET=cos
ExecStart=/bin/bash ops/backup.sh ${BACKUP_TARGET}
NoNewPrivileges=true
